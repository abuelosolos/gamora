{
  "permissions": {
    "allow": [
      "Read(./.env.example)",
      "Bash(npm run:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npx drizzle-kit migrate:*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(!.env.example)",
      "Edit(.env*)",
      "Edit(**/.env*)",
      "Edit(!.env.example)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Bash(cat *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep *.env*)",
      "Bash(rg *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(cp *.env*)",
      "Bash(mv *.env*)",
      "Bash(rm *.env*)",
      "Bash(nano *.env*)",
      "Bash(vi *.env*)",
      "Bash(vim *.env*)",
      "Bash(code *.env*)",
      "Bash(source *.env*)",
      "Bash(. *.env*)",
      "Bash(* > *.env*)",
      "Bash(* >> *.env*)",
      "Bash(tee *.env*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(vercel env:*)",
      "Bash(git push*)",
      "Bash(*git push*)",
      "Bash(git * push*)",
      "Bash(rm -rf:*)"
    ]
  }
}
